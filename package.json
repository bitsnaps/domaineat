{
  "name": "domaineat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx api/server.ts",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "build": "vue-tsc -b && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "node dist-api/server.js",
    "preview": "vite preview",
    "test": "vitest run tests/*",
    "test:coverage": "vitest run tests/* --coverage",
    "migrate": "tsx api/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "dotenv": "^17.4.2",
    "hono": "^4.12.21",
    "jose": "^6.2.3",
    "pg": "^8.21.0",
    "pg-hstore": "^2.3.4",
    "pinia": "^3.0.4",
    "sequelize": "6",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.1.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^29.1.1",
    "sequelize-cli": "6",
    "tsx": "^4.22.3",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.2.5"
  },
  "packageManager": "pnpm@9.15.9"
}
