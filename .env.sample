# Domaineat Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit your .env file to version control

# ─── Required ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgres://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Secret key for signing JWT tokens (min 32 characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# AES-256 encryption key for encrypting stored LLM API keys (32-byte hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# GoDaddy API credentials for domain registration/management
# Obtain from: https://developer.godaddy.com/keys
GODADDY_API_KEY=
GODADDY_SECRET_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────

# Application environment: development | production | test
# Defaults to "development" if not set
NODE_ENV=development

# ─── Netlify Deployment ───────────────────────────────────────────────────
#
# When deploying to Netlify, set ALL the above variables in:
#   Netlify UI → Site settings → Environment variables
#
# Required Netlify environment variables:
#   DATABASE_URL        — PostgreSQL connection string (e.g. Neon, Supabase, Railway)
#   JWT_SECRET          — Must be a strong random string (32+ chars)
#   ENCRYPTION_KEY      — 32-byte hex string for API key encryption
#   GODADDY_API_KEY     — GoDaddy API key
#   GODADDY_SECRET_KEY  — GoDaddy API secret
#   NODE_ENV            — Set to "production"
#
# Note: Netlify automatically sets NODE_ENV=production during builds.
# The app validates these on startup and will fail in production if missing.
