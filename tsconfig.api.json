{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "outDir": "dist-api",
    "rootDir": "api",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false
  },
  "include": ["api/server.ts", "api/app.ts", "api/models/**/*.ts", "api/migrate.ts", "api/dns-check.ts", "api/domain-analysis.ts"]
}
